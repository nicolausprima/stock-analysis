# Konfigurasi AI Agent (Omniroute) — contoh lokal; ganti via env/secret manager.
OPENAI_API_BASE="http://127.0.0.1:20128/v1"
# Placeholder contoh (bukan kredensial nyata): ganti dengan nilai dari secret manager.
OPENAI_API_KEY="ganti-dengan-kunci-lokal"

# Keamanan API: WAJIB untuk deployment publik (APP_ENV=production fail-startup tanpa ini).
# Semua request ke endpoint sensitif (/api/sync, /api/recommendations?force=true,
# /api/narasi, /api/narasi/multi-agent, /api/telegram/*, /api/audit/run,
# /api/audit/seed-simulation) harus membawa header:
#   X-API-Key: <nilai_ini>
# Frontend: JANGAN pakai ?api_key= di URL (bocor ke history/log/referrer).
# Set manual di console browser: window.setStockAIApiKey('<nilai_ini>')
# (disimpan di sessionStorage, hilang saat tab ditutup).
API_AUTH_TOKEN=""
APP_ENV="development"
# Pisahkan worker dari web API (cegah job ganda di multi-replica):
ENABLE_SCHEDULER="false"
ENABLE_TELEGRAM_LISTENER="false"
# Override DuckDB (opsional, untuk test isolation):
# DUCKDB_FUNDAMENTAL_PATH=""
# DUCKDB_MARKET_PATH=""

# Telegram Bot Notification Configuration
# Token HANYA via env/secret manager — JANGAN tulis token asli di file/.env kerja.
# Revoke token bocor via @BotFather. Allowlist chat (koma) wajib agar listener fail-closed.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ALLOWED_CHAT_IDS=""
# Tuning infra (opsional):
# DUCKDB_THREADS="4"
# DUCKDB_MEMORY_LIMIT="2GB"
# DUCKDB_LOCK_TIMEOUT_SEC="30"
# RSS_TIMEOUT_SEC="15"