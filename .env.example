# Konfigurasi AI Agent (Omniroute)
OPENAI_API_BASE="http://127.0.0.1:20128/v1"
OPENAI_API_KEY="sk-xxxx"

# Keamanan API: wajib untuk deployment publik.
# Semua request ke endpoint sensitif (/api/sync, /api/recommendations?force=true,
# /api/narasi, /api/narasi/multi-agent, /api/telegram/*, /api/audit/run,
# /api/audit/seed-simulation) harus membawa header:
#   X-API-Key: <nilai_ini>
# Frontend: buka dashboard dengan ?api_key=<nilai_ini>. Key otomatis disimpan ke
# localStorage lalu dihapus dari address bar. Jika kosong, endpoint sensitif
# TIDAK dilindungi (mode lokal).
API_AUTH_TOKEN=""

# Telegram Bot Notification Configuration
TELEGRAM_BOT_TOKEN="isi_token_dari_botfather"
TELEGRAM_CHAT_ID=""